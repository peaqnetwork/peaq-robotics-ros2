<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>peaq_ros2_core</name>
  <version>1.0.0</version>
  <description>Core ROS 2 nodes for peaq blockchain integration</description>
  <maintainer email="robotics@peaq.network">peaq robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>peaq_ros2_interfaces</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>lifecycle</exec_depend>
  <exec_depend>peaq_robot</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
