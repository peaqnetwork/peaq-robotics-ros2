# Submit one peaqOS machine event on-chain through EventRegistry.
#
# signer_address selects a locally stored EVM wallet. If empty, the node uses
# its configured default machine address.
# raw_data_hex and metadata_hex are 0x-prefixed byte strings. Empty raw_data_hex
# means "no raw data" and submits bytes32(0) as the data hash.

string signer_address
uint64 machine_id
uint8 event_type
uint64 value
uint64 timestamp
string raw_data_hex
uint8 trust_level
uint64 source_chain_id
string source_tx_hash
string metadata_hex
---
string tx_hash
string data_hash
bool success
string error_code
string error_field
string error
